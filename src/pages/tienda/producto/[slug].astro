---
import Layout from '../../../layouts/Layout.astro';
import courses from '../../../data/courses.json';
export function getStaticPaths(){return courses.map(course=>({params:{slug:course.slug},props:{course}}));}
const {course}=Astro.props;
---
<Layout title={`${course.title} — Bull & Bear Academy`}><section class="page-hero wrap"><a class="text-button" href="/tienda/">← Todos los cursos</a><span class="eyebrow product-eyebrow">{course.category}</span><h1>{course.title}</h1></section><section class="section-pad wrap split course-detail"><div><span class="eyebrow">EL SIGUIENTE PASO EN TU FORMACIÓN</span><h2>Profundiza.<br/><em>Construye criterio.</em></h2><p>Conoce el programa y conversa con la academia para valorar si responde a tus objetivos.</p></div><div class="session-card"><dl><div><dt>Duración publicada</dt><dd>{course.duration}</dd></div>{course.mentor && <div><dt>Mentor</dt><dd>{course.mentor}</dd></div>}<div><dt>Área de formación</dt><dd>{course.category}</dd></div></dl><a href={course.official} class="button button-dark" target="_blank" rel="noopener noreferrer">Consultar la ficha oficial <span>↗</span></a><p>La academia confirma el temario, precio, modalidad y próximas fechas. La inscripción se realiza en sus canales oficiales.</p></div></section></Layout>