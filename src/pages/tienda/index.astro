---
import { getLocale, translator, getCourses } from "../../i18n/index";
import Layout from '../../layouts/Layout.astro';

const lang = getLocale(Astro.url.pathname);
const t = translator(lang);
const courses = getCourses(lang);
const categories = ['Todos','Forex','Criptomonedas','Finanzas','Futuros','Opciones'];
---
<Layout title={t("Cursos — Bull & Bear Academy")}><section class="page-hero wrap"><span class="eyebrow">{t("NUESTROS CURSOS · 12 PROGRAMAS")}</span><h1>{t("Encuentra tu")}<br/><em>{t("siguiente nivel.")}</em></h1><p>{t("Explora el catálogo y elige dónde quieres profundizar.")}</p></section><section class="wrap catalog-section"><div class="catalog-filters" role="group" aria-label={t("Filtrar cursos")}>{categories.map((c,i)=><button data-category={c} aria-pressed={i===0}>{t(c)}</button>)}</div><p id="course-count" aria-live="polite">{t("12 cursos")}</p><div class="catalog-grid">{courses.map((c,i)=><a class="catalog-card" href={c.url} data-course-category={c.category}><span class="course-meta">{t(c.category)}</span><span class="catalog-index">{String(i+1).padStart(2,'0')}</span><h2>{c.title}</h2><div><span>{c.duration}</span><span>{t("Explorar ↗")}</span></div></a>)}</div><p class="catalog-note">{t("Consulta precios, modalidades y disponibilidad en la ficha oficial de cada programa.")}</p></section></Layout>