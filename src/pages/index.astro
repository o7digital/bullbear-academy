---
import { getLocale, translator, localizePath } from "../i18n/index";
import Layout from "../layouts/Layout.astro";
import Mentors from "../components/Mentors.astro";
import Session from "../components/Session.astro";

const lang = getLocale(Astro.url.pathname);
const t = translator(lang);
---
<Layout home={true}><div class="dark-opening">    <section class="hero wrap" aria-labelledby="hero-title">
     <div class="hero-content">
      <div class="eyebrow"><span class="short-rule"></span> {t("BULL & BEAR ACADEMY · MÉXICO")}</div>
      <h1 id="hero-title">{t("Aprende.")}<br/>{t("Opera.")}<br/><em>{t("Crece.")}</em></h1>
      <p>{t("Aprende a leer los mercados, gestionar el riesgo")}<br class="desktop-break"/> {t("y tomar decisiones con fundamento.")}</p>
      <a class="button button-light" href={localizePath("/tienda/", lang)}>{t("Encuentra tu programa")} <span>↗</span></a>
      <div class="hero-footnote"><span class="tiny-star">✳</span> {t("Conocimiento. Disciplina. Perspectiva.")}</div>
     </div>
     <figure class="hero-art"><img src="/assets/hero.webp" alt={t("Esculturas de un toro y un oso en bronce, frente a frente en una galería de piedra")} width="1536" height="1024" fetchpriority="high"/><div class="art-shade"></div><figcaption><span>{t("EL EQUILIBRIO EMPIEZA EN TI.")}</span><span>{t("CONOCIMIENTO EN MOVIMIENTO")}</span></figcaption></figure>
     <div class="hero-side-label">{t("MÉXICO · UNA VISIÓN GLOBAL")}</div>
    </section>
    <div class="hero-baseline wrap"><div><span class="small-index">01 /</span> {t("Formación en vivo y online")}</div><div><span class="small-index">02 /</span> {t("Acompañamiento personal")}</div><div><span class="small-index">03 /</span> {t("Del fundamento a la práctica")}</div><a href="#formacion" aria-label={t("Explorar la academia")}>{t("EXPLORAR")} <span>↓</span></a></div>
</div><section id="formacion" class="section-pad wrap"><div class="section-label"><span>{t("01 — EDUCACIÓN PROFESIONAL")}</span><span>{t("EL VALOR DE ENTENDER")}</span></div><div class="section-heading"><h2>{t("Tu formación.")}<br/><em>{t("Tu siguiente nivel.")}</em></h2><p>{t("Un punto de partida claro.")}<br/>{t("Un acompañamiento a tu medida.")}</p></div><div class="feature-grid"><article><span>01 /</span><h3>{t("Mentoría personal")}</h3><p>{t("Una conversación cercana para trabajar tus dudas y construir tu proceso.")}</p></article><article><span>02 /</span><h3>{t("Gestión del riesgo")}</h3><p>{t("Aprende a definir límites antes de tomar una posición.")}</p></article><article><span>03 /</span><h3>{t("Lectura del mercado")}</h3><p>{t("Da contexto a los movimientos y contrasta tus ideas.")}</p></article><article><span>04 /</span><h3>{t("Programas por nivel")}</h3><p>{t("Encuentra la formación que corresponde a tu experiencia.")}</p></article></div><a class="text-button" href={localizePath("/tienda/", lang)}>{t("Explorar los 12 cursos")} <span>↗</span></a></section><section class="recognition wrap"><span class="recognition-year">2024</span><div><span class="eyebrow">{t("UNA TRAYECTORIA QUE SIGUE CRECIENDO")}</span><h2>{t("Nominados a mejor")}<br/>{t("academia de trading.")}</h2></div><a href={localizePath("/nosotros/", lang)} class="text-button">{t("Nuestra historia ↗")}</a></section><section class="section-pad trading-section"><div class="wrap split"><div><span class="eyebrow">{t("02 — ENTENDER EL TRADING")}</span><h2>{t("Todo empieza")}<br/>{t("con una")} <em>{t("pregunta.")}</em></h2></div><div class="editorial-copy"><h3>{t("¿Qué es el trading?")}</h3><p>{t("Consiste en comprar y vender instrumentos financieros. Forex es uno de sus mercados; también existen acciones, futuros, opciones y activos digitales.")}</p><p>{t("Antes de operar, conviene entender el instrumento, el horizonte de la operación y el capital que se está dispuesto a arriesgar.")}</p><a class="text-button" href={localizePath("/preguntas-frecuentes-faq/", lang)}>{t("Resuelve tus dudas ↗")}</a></div></div></section><section class="method section-pad"><div class="wrap"><div class="section-label"><span>03 — TRADING CLUB</span><span>{t("LA CONVERSACIÓN CONTINÚA")}</span></div><div class="method-grid"><div><h2>{t("El mercado,")}<br/><em>{t("en perspectiva.")}</em></h2><p>{t("Observa el análisis, haz preguntas y sigue aprendiendo junto a la comunidad.")}</p><a class="button button-light" href={localizePath("/trading-club/", lang)}>{t("Conoce el Trading Club")} <span>↗</span></a></div><div class="club-panel"><span class="eyebrow">{t("ENCUENTROS Y CONTENIDOS")}</span><h3>{t("Análisis.")}<br/>{t("Práctica.")}<br/>{t("Comunidad.")}</h3><a class="text-button" href={localizePath("/aprende-lo-fundamental-del-trading/", lang)}>{t("Explorar los webinars ↗")}</a><p>{t("Consulta la programación vigente con la academia.")}</p></div></div></div></section><section class="section-pad wrap"><div class="section-label"><span>04 — B&B NEWS</span><span>{t("ACTUALIDAD DE LA ACADEMIA")}</span></div><div class="section-heading"><h2>{t("Ideas para")}<br/><em>{t("seguir avanzando.")}</em></h2><a class="text-button" href={localizePath("/proximos-eventos/", lang)}>{t("Explorar eventos ↗")}</a></div><div class="news-grid"><a href={localizePath("/tienda/", lang)}><span class="eyebrow">{t("FORMACIÓN")}</span><span class="news-symbol">12</span><h3>{t("Un catálogo.")}<br/>{t("Distintas perspectivas.")}</h3><span>{t("Explorar los cursos ↗")}</span></a><a href={localizePath("/trading-club/", lang)}><span class="eyebrow">{t("COMUNIDAD")}</span><span class="news-symbol">↗</span><h3>{t("Aprender también")}<br/>{t("es conversar.")}</h3><span>{t("Conocer el Trading Club ↗")}</span></a><a href={localizePath("/guerra-de-traders/", lang)}><span class="eyebrow">{t("CULTURA FINANCIERA")}</span><span class="news-symbol">B&B</span><h3>Guerra de Traders.<br/>{t("Del aula al mercado.")}</h3><span>{t("Conocer el proyecto ↗")}</span></a></div></section><Session/><Mentors/><section class="section-pad wrap tec-section"><div class="section-label"><span>{t("06 — CULTURA FINANCIERA")}</span><span>GUERRA DE TRADERS</span></div><div class="split"><h2>{t("El conocimiento")}<br/>{t("se vuelve")} <em>{t("experiencia.")}</em></h2><div class="editorial-copy"><h3>{t("Un encuentro con el")}<br/>Tecnológico de Monterrey.</h3><p>{t("Bull & Bear Academy presenta su participación en Guerra de Traders: un proyecto para acercar la cultura financiera a nuevas generaciones.")}</p><a class="text-button" href={localizePath("/guerra-de-traders/", lang)}>{t("Conoce el proyecto ↗")}</a></div></div></section></Layout>