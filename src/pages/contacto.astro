---
import { getLocale, translator } from "../i18n/index";
import Layout from "../layouts/Layout.astro";
import Session from "../components/Session.astro";

const lang = getLocale(Astro.url.pathname);
const t = translator(lang);
---
<Layout title={t("Contacto — Bull & Bear Academy")}><section class="page-hero wrap"><span class="eyebrow">{t("HABLEMOS DE TU FORMACIÓN")}</span><h1>{t("Tu próximo paso")}<br/><em>{t("empieza aquí.")}</em></h1></section><Session/><section class="section-pad wrap split"><div><span class="eyebrow">{t("ENCUÉNTRANOS")}</span><h2>{t("Ciudad de")}<br/><em>{t("México.")}</em></h2></div><div class="editorial-copy"><address>{t("Av. Insurgentes Sur 716, piso 8, ala poniente")}<br/>Col. Del Valle, C.P. 03103, Benito Juárez<br/>{t("Ciudad de México")}</address><a class="text-button" href="mailto:info@bullandbear-academy.com">info@bullandbear-academy.com ↗</a><br/><a class="text-button" href="https://wa.me/525564304548" target="_blank" rel="noopener noreferrer">+52 55 6430 4548 · WhatsApp ↗</a></div></section></Layout>