---
import { getLocale, translator, localizePath } from "../i18n/index";
import Layout from "../layouts/Layout.astro";
import Session from "../components/Session.astro";

const lang = getLocale(Astro.url.pathname);
const t = translator(lang);
---
<Layout title="Trading Club — Bull & Bear Academy"><section class="page-hero wrap"><span class="eyebrow">{t("LA COMUNIDAD B&B")}</span><h1>{t("El mercado se mueve.")}<br/><em>{t("Aprendemos juntos.")}</em></h1></section><section class="method section-pad"><div class="wrap"><div class="section-label"><span>{t("03 — TRADING CLUB")}</span><span>{t("LA CONVERSACIÓN CONTINÚA")}</span></div><div class="method-grid"><div><h2>{t("El mercado,")}<br/><em>{t("en perspectiva.")}</em></h2><p>{t("Observa el análisis, haz preguntas y sigue aprendiendo junto a la comunidad.")}</p><a class="button button-light" href={localizePath("/trading-club/", lang)}>{t("Conoce el Trading Club")} <span>↗</span></a></div><div class="club-panel"><span class="eyebrow">{t("ENCUENTROS Y CONTENIDOS")}</span><h3>{t("Análisis.")}<br/>{t("Práctica.")}<br/>{t("Comunidad.")}</h3><a class="text-button" href={localizePath("/aprende-lo-fundamental-del-trading/", lang)}>{t("Explorar los webinars ↗")}</a><p>{t("Consulta la programación vigente con la academia.")}</p></div></div></div></section><section class="section-pad wrap"><div class="section-label"><span>{t("ARCHIVO DE SESIONES")}</span><span>{t("ENCUENTROS ANTERIORES")}</span></div><div class="archive-row"><span>{t("ENERO 2026")}</span><h2>{t("Sesiones de Swing Trading")}</h2><a class="text-button" href="https://www.youtube.com/channel/UC9wnSm8oPpYTOJOyTgS3DWA" target="_blank" rel="noopener noreferrer">{t("Explorar el canal ↗")}</a></div><div class="archive-row"><span>{t("NOVIEMBRE 2025")}</span><h2>{t("Futuros & Swing Trading")}</h2><a class="text-button" href="https://www.youtube.com/channel/UC9wnSm8oPpYTOJOyTgS3DWA" target="_blank" rel="noopener noreferrer">{t("Explorar el canal ↗")}</a></div><p class="catalog-note">{t("Sesiones anteriores. Para conocer las próximas fechas, consulta directamente con la academia.")}</p></section><Session/></Layout>