---
import { getLocale, translator, localizePath } from "../i18n/index";
import Layout from "../layouts/Layout.astro";

const lang = getLocale(Astro.url.pathname);
const t = translator(lang);
---
<Layout title="Videos — Bull & Bear Academy"><section class="page-hero wrap"><span class="eyebrow">{t("LA VIDEOTECA")}</span><h1>{t("Una idea puede")}<br/><em>{t("abrir un camino.")}</em></h1></section><section class="section-pad wrap video-grid"><a class="video-card" href={localizePath("/aprende-lo-fundamental-del-trading/", lang)}><span class="play-symbol">▷</span><span class="eyebrow">{t("FORMACIÓN")}</span><h2>{t("Webinars")}</h2><p>{t("Conversaciones para profundizar en el mundo del trading.")}</p><span>{t("Explorar ↗")}</span></a><a class="video-card" href={localizePath("/guerra-de-traders/", lang)}><span class="play-symbol">▷</span><span class="eyebrow">{t("CULTURA FINANCIERA")}</span><h2>Guerra de Traders</h2><p>{t("Una iniciativa para acercar los mercados a nuevas generaciones.")}</p><span>{t("Explorar ↗")}</span></a></section></Layout>