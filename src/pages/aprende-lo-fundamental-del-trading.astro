---
import { getLocale, translator } from "../i18n/index";
import Layout from "../layouts/Layout.astro";

const lang = getLocale(Astro.url.pathname);
const t = translator(lang);
---
<Layout title="Webinars — Bull & Bear Academy"><section class="page-hero wrap"><span class="eyebrow">{t("APRENDE LO FUNDAMENTAL")}</span><h1>{t("El conocimiento")}<br/><em>{t("se comparte.")}</em></h1></section><section class="section-pad wrap split"><div class="video-card"><span class="play-symbol">▷</span><h2>Webinars B&B</h2></div><div class="editorial-copy"><h2>{t("Más preguntas.")}<br/>{t("Más")} <em>{t("perspectiva.")}</em></h2><p>{t("Encuentra conversaciones, análisis y contenido de la academia en su canal oficial.")}</p><a class="button button-dark" href="https://www.youtube.com/channel/UC9wnSm8oPpYTOJOyTgS3DWA" target="_blank" rel="noopener noreferrer">{t("Abrir el canal de la academia ↗")}</a></div></section></Layout>