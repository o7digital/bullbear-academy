---
import { getLocale, translator, localizePath } from "../i18n/index";
import Layout from "../layouts/Layout.astro";

const lang = getLocale(Astro.url.pathname);
const t = translator(lang);
---
<Layout title="Guerra de Traders — Bull & Bear Academy"><section class="page-hero wrap"><span class="eyebrow">{t("UNA INICIATIVA DE CULTURA FINANCIERA")}</span><h1>Guerra de<br/><em>Traders.</em></h1></section><section class="section-pad wrap tec-section"><div class="section-label"><span>{t("06 — CULTURA FINANCIERA")}</span><span>GUERRA DE TRADERS</span></div><div class="split"><h2>{t("El conocimiento")}<br/>{t("se vuelve")} <em>{t("experiencia.")}</em></h2><div class="editorial-copy"><h3>{t("Un encuentro con el")}<br/>Tecnológico de Monterrey.</h3><p>{t("Bull & Bear Academy presenta su participación en Guerra de Traders: un proyecto para acercar la cultura financiera a nuevas generaciones.")}</p><a class="text-button" href={localizePath("/guerra-de-traders/", lang)}>{t("Conoce el proyecto ↗")}</a></div></div></section><section class="wrap event-intro"><p>{t("Explora el archivo del proyecto y sus contenidos audiovisuales.")}</p><a class="button button-dark" href="https://www.bullandbear-academy.com/guerra-de-traders/" target="_blank" rel="noopener noreferrer">{t("Ver el archivo original ↗")}</a></section></Layout>