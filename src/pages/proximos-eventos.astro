---
import { getLocale, translator } from "../i18n/index";
import Layout from "../layouts/Layout.astro";

const lang = getLocale(Astro.url.pathname);
const t = translator(lang);
---
<Layout title={t("Eventos — Bull & Bear Academy")}><section class="page-hero wrap"><span class="eyebrow">{t("ENCUENTROS DE LA ACADEMIA")}</span><h1>{t("Una comunidad.")}<br/><em>{t("Muchos encuentros.")}</em></h1></section><section class="wrap event-intro"><p>{t("Explora la actividad de Bull & Bear Academy y consulta las próximas convocatorias.")}</p><button class="button button-dark" data-contact>{t("Consultar próximos eventos ↗")}</button></section><section class="section-pad wrap"><div class="section-label"><span>{t("ARCHIVO DE SESIONES")}</span><span>{t("ENCUENTROS ANTERIORES")}</span></div><div class="archive-row"><span>{t("ENERO 2026")}</span><h2>{t("Sesiones de Swing Trading")}</h2><a class="text-button" href="https://www.youtube.com/channel/UC9wnSm8oPpYTOJOyTgS3DWA" target="_blank" rel="noopener noreferrer">{t("Explorar el canal ↗")}</a></div><div class="archive-row"><span>{t("NOVIEMBRE 2025")}</span><h2>{t("Futuros & Swing Trading")}</h2><a class="text-button" href="https://www.youtube.com/channel/UC9wnSm8oPpYTOJOyTgS3DWA" target="_blank" rel="noopener noreferrer">{t("Explorar el canal ↗")}</a></div><p class="catalog-note">{t("Sesiones anteriores. Para conocer las próximas fechas, consulta directamente con la academia.")}</p></section></Layout>