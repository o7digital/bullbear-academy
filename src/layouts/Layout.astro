---
import { getLocale, translator, localizePath, locales, languageNames, languageTags } from "../i18n/index";
import '../styles/global.css';

const lang = getLocale(Astro.url.pathname);
const t = translator(lang);
const { title = 'Bull & Bear Academy — Formación con criterio', description = 'Formación en trading, mentoría y cultura financiera. Bull & Bear Academy.', home = false } = Astro.props;
const nav = [["Inicio", "/"], ["Nosotros", "/nosotros/"], ["Trading Club", "/trading-club/"], ["Videos", "/videos/"], ["Eventos", "/proximos-eventos/"], ["Cursos", "/tienda/"], ["Contacto", "/contacto/"], ["FAQ", "/preguntas-frecuentes-faq/"]];
const path = Astro.url.pathname;
const clientMessages = {
  requiredName: t("Escribe tu nombre."),
  inquiry: t("Hola, soy {name}. Quiero información sobre la formación de Bull & Bear Academy. Mi experiencia: {level}. Me interesa: {interest}. ¿Podrían orientarme sobre programas y disponibilidad para una sesión?"),
  courseCount: { one: t("{count} curso"), few: t("{count} cursos (pocos)"), other: t("{count} cursos") },
};
---
<!doctype html><html lang={languageTags[lang]}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t(title)}</title><meta name="description" content={t(description)}/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#e25814"/><link rel="stylesheet" href="/assets/fonts.css"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>{home && <link rel="preload" href="/assets/hero.webp" as="image"/>}</head><body data-ui={JSON.stringify(clientMessages)}>
<a class="skip-link" href="#main">{t("Saltar al contenido")}</a><div class="concept-strip"><span>{t("BULL & BEAR ACADEMY · PROPUESTA DE REDISEÑO")}</span><span><span>{t("Vista previa privada · Octubre 2026")}</span><nav class="language-switch" aria-label={t("Idioma")}>{locales.map(locale => <a href={localizePath(path, locale)} lang={languageTags[locale]} hreflang={languageTags[locale]} aria-current={lang === locale ? 'page' : undefined} aria-label={languageNames[locale]}><span class="language-short">{locale === 'zh' ? '中文' : locale.toUpperCase()}</span><span class="language-full">{languageNames[locale]}</span></a>)}</nav></span></div>
<div class="site-header"><header class="header wrap"><a class="brand official-brand" href={localizePath("/", lang)} aria-label={t("Bull & Bear Academy, inicio")}><img src="/assets/logo-official.png" alt="Bull & Bear Academy" width="310" height="80"/></a><nav class="desktop-nav" aria-label={t("Navegación principal")}>{nav.map(([label,href]) => label === 'Videos' ? <details class="nav-dropdown"><summary>{t("Videos")} <span>⌄</span></summary><div><a href={localizePath("/videos/", lang)}>{t("Todos los videos")}</a><a href={localizePath("/aprende-lo-fundamental-del-trading/", lang)}>{t("Webinars")}</a><a href={localizePath("/guerra-de-traders/", lang)}>{t("Guerra de Traders")}</a></div></details> : <a href={localizePath(href, lang)} aria-current={path===localizePath(href, lang)?'page':undefined}>{t(label)}</a>)}</nav><a class="nav-cta" href={localizePath("/contacto/", lang)}>{t("Inscríbete")} <span>↗</span></a><button class="menu-toggle" aria-label={t("Abrir menú")} aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button></header><nav id="mobile-nav" class="mobile-nav" hidden aria-label={t("Navegación móvil")}>{nav.map(([label,href])=><a href={localizePath(href, lang)}>{t(label)}</a>)}<a href={localizePath("/aprende-lo-fundamental-del-trading/", lang)}>{t("Webinars")}</a><a href={localizePath("/guerra-de-traders/", lang)}>{t("Guerra de Traders")}</a></nav></div>
<main id="main"><slot/></main>
<footer><div class="wrap"><div class="footer-main"><a class="brand official-brand" href={localizePath("/", lang)}><img src="/assets/logo-official.png" alt="Bull & Bear Academy" width="310" height="80"/></a><p>{t("Conocimiento que forma.")}<br/>{t("Criterio que permanece.")}</p><div><span class="footer-label">{t("CIUDAD DE MÉXICO")}</span><address>{t("Insurgentes Sur 716, piso 8, ala poniente")}<br/>Col. Del Valle, Benito Juárez, C.P. 03103</address><a class="footer-email" href="mailto:info@bullandbear-academy.com">info@bullandbear-academy.com</a></div><a class="footer-contact" href="https://wa.me/525564304548" target="_blank" rel="noopener noreferrer">WhatsApp ↗<small>+52 55 6430 4548</small></a></div><div class="footer-bottom"><span>{t("© 2026 · Propuesta de rediseño Bull & Bear Academy")}</span><button id="concept-info">{t("Acerca de esta propuesta ↗")}</button><a href="https://www.bullandbear-academy.com/aviso-de-privacidad/" target="_blank" rel="noopener noreferrer">{t("Aviso de privacidad ↗")}</a><a href="#main">{t("Volver arriba ↑")}</a></div><p class="risk-note">{t("El trading implica riesgos y puede causar pérdida de capital. No se garantizan rendimientos.")}</p></div></footer>
  <dialog id="contact-dialog" class="contact-dialog" aria-label={t("Hablemos de tu formación")}><button class="dialog-close" aria-label={t("Cerrar formulario de contacto")}>×</button><div class="dialog-eyebrow">{t("UNA CONVERSACIÓN, UN PUNTO DE PARTIDA")}</div><h2>{t("Hablemos de")}<br/>{t("tu")} <em>{t("formación.")}</em></h2><p class="dialog-description">{t("Cuéntanos dónde estás y qué te gustaría aprender.")}</p><form id="contact-form"><label for="contact-name">{t("Tu nombre")}</label><input id="contact-name" name="name" placeholder={t("¿Cómo te llamas?")} required maxlength="80" autocomplete="given-name"/><div class="form-grid"><div><label for="contact-level">{t("Tu experiencia")}</label><select id="contact-level" name="level"><option>{t("Estoy comenzando")}</option><option>{t("Ya tengo conocimientos")}</option><option>{t("Busco especializarme")}</option></select></div><div><label for="contact-interest">{t("Me interesa")}</label><select id="contact-interest" name="interest"><option>{t("Necesito orientación")}</option><option>{t("Fundamentos del trading")}</option><option>{t("Forex")}</option><option>{t("Futuros y opciones")}</option><option>{t("Cripto y blockchain")}</option><option>{t("Mentoría personal")}</option></select></div></div><button class="button button-dark" type="submit">{t("Preparar mi consulta")} <span>↗</span></button><p class="dialog-note">{t("Esta maqueta no guarda tus datos. Podrás revisar tu mensaje antes de abrir el WhatsApp oficial de la academia.")}</p></form><div id="contact-review" hidden><span class="syllabus-label">{t("TU MENSAJE ESTÁ LISTO")}</span><p id="review-message"></p><a id="whatsapp-link" class="button button-dark" href="https://wa.me/525564304548" target="_blank" rel="noopener noreferrer">{t("Abrir WhatsApp de la academia")} <span>↗</span></a><button id="edit-message" class="text-button">{t("← Editar mi consulta")}</button><p class="dialog-note">{t("Se abrirá una conversación con la academia real. Tú decides si envías el mensaje.")}</p></div></dialog>
  <dialog id="about-dialog" aria-label={t("Acerca de esta propuesta")}><button class="dialog-close" aria-label={t("Cerrar información")}>×</button><div class="dialog-eyebrow">{t("CONCEPTO DE REDISEÑO")}</div><h2>{t("Una nueva")}<br/><em>{t("perspectiva.")}</em></h2><p class="dialog-description">{t("Maqueta interactiva de una posible nueva identidad digital de Bull & Bear Academy. No es el sitio oficial y no permite comprar cursos ni reservar clases.")}</p><p class="dialog-note">{t("Los nombres, especialidades, retratos y datos de contacto provienen del sitio público de la academia. La dirección artística, los textos y las rutas de aprendizaje son propuestas creativas. El visual de las esculturas fue generado para este concepto.")}</p><a class="text-button" href="https://www.bullandbear-academy.com/" target="_blank" rel="noopener noreferrer">{t("Consultar el sitio oficial ↗")}</a></dialog>

<script src="/app.js" is:inline></script></body></html>