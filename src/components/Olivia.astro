---
import { getLocale, languageTags } from '../i18n/index';
import { oliviaCopy } from '../data/olivia';
import '../styles/olivia.css';
const lang = getLocale(Astro.url.pathname);
const copy = oliviaCopy[lang];
---
<div class="olivia-widget" data-olivia data-language={lang} data-copy={JSON.stringify(oliviaCopy)}>
  <dialog id="olivia-panel" class="olivia-panel" aria-labelledby="olivia-title" lang={languageTags[lang]}>
    <header class="olivia-head">
      <div class="olivia-heading">
        <span class="olivia-spark" aria-hidden="true">✧</span>
        <div><p class="olivia-brand">Bull & Bear Academy</p><h2 id="olivia-title">Charly IA</h2></div>
        <button class="olivia-close" type="button" data-olivia-close aria-label={copy.close}>×</button>
      </div>
      <div class="olivia-toolbar">
        <span class="olivia-presence"><i aria-hidden="true"></i><span data-olivia-text="available">{copy.available}</span></span>
      </div>
    </header>
    <div class="olivia-log" data-olivia-log role="log" aria-live="polite" aria-relevant="additions text">
      <article class="olivia-message" data-role="assistant"><b>Charly</b><p>{copy.greeting}</p></article>
    </div>
    <div class="olivia-suggestions">
      <button type="button" data-olivia-prompt="coursesPrompt" data-olivia-text="courses">{copy.courses}</button>
      <button type="button" data-olivia-prompt="clubPrompt" data-olivia-text="club">{copy.club}</button>
      <button type="button" data-olivia-prompt="contactPrompt" data-olivia-text="contact">{copy.contact}</button>
    </div>
    <div class="olivia-bottom">
      <p class="olivia-feedback" data-olivia-feedback role="status"></p>
      <a class="olivia-contact" data-olivia-contact href="https://wa.me/525564304548" target="_blank" rel="noopener noreferrer" hidden><span data-olivia-text="contact">{copy.contact}</span> ↗</a>
      <label class="olivia-consent"><input type="checkbox" data-olivia-consent/><span data-olivia-text="consent">{copy.consent}</span></label>
      <form class="olivia-form" data-olivia-form>
        <button class="olivia-mic" type="button" data-olivia-mic aria-label={copy.mic} hidden><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8"/></svg></button>
        <textarea data-olivia-input rows="1" maxlength="4000" placeholder={copy.placeholder} aria-label={copy.placeholder} required></textarea>
        <button class="olivia-send" type="submit" data-olivia-send aria-label={copy.send} disabled><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4 20-7ZM22 2 11 13"/></svg></button>
      </form>
      <div class="olivia-meta"><button type="button" data-olivia-reset>↻ <span data-olivia-text="clear">{copy.clear}</span></button><details class="olivia-privacy"><summary data-olivia-text="privacy">{copy.privacy}</summary><p data-olivia-text="privacyBody">{copy.privacyBody}</p><a href="https://www.bullandbear-academy.com/aviso-de-privacidad/" target="_blank" rel="noopener noreferrer"><span data-olivia-text="privacy">{copy.privacy}</span> ↗</a></details></div>
    </div>
  </dialog>
  <template data-olivia-lead-template>
    <form class="olivia-lead" data-olivia-lead>
      <h3 data-olivia-text="leadTitle">{copy.leadTitle}</h3>
      <p data-olivia-text="leadIntro">{copy.leadIntro}</p>
      <div class="olivia-lead-names">
        <label><span data-olivia-text="firstName">{copy.firstName}</span><input name="firstName" autocomplete="given-name" maxlength="100" required/></label>
        <label><span data-olivia-text="lastName">{copy.lastName}</span><input name="lastName" autocomplete="family-name" maxlength="100" required/></label>
      </div>
      <label><span data-olivia-text="email">{copy.email}</span><input name="email" type="email" autocomplete="email" maxlength="254" required/></label>
      <label><span data-olivia-text="phone">{copy.phone}</span><input name="phone" type="tel" autocomplete="tel" maxlength="40" required/></label>
      <label><span data-olivia-text="details">{copy.details}</span><textarea name="details" rows="3" maxlength="4000" required></textarea></label>
      <label class="olivia-consent"><input name="contactConsent" type="checkbox" required/><span data-olivia-text="leadConsent">{copy.leadConsent}</span></label>
      <p data-lead-feedback role="status"></p>
      <button type="submit" class="olivia-lead-submit" data-olivia-text="leadSubmit">{copy.leadSubmit}</button>
      <button type="button" class="olivia-lead-cancel" data-lead-cancel data-olivia-text="leadCancel">{copy.leadCancel}</button>
    </form>
  </template>
  <button class="olivia-launcher" type="button" data-olivia-open aria-controls="olivia-panel" aria-expanded="false" aria-label={copy.open}><span class="olivia-launcher-label">Charly IA <small data-olivia-text="subtitle">{copy.subtitle}</small></span><span class="olivia-launcher-icon"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg><i></i></span></button>
</div>
<script>import '../scripts/olivia';</script>
