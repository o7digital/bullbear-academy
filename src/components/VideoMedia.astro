---
import {videoDetails} from '../../cms/studio/public/media.js';
const {value,title='',poster}=Astro.props;
const media=videoDetails(value);
---
{media&&<div class:list={['published-video',{'published-video-link':media.type==='link'}]}>
 {media.type==='youtube'||media.type==='vimeo'?<iframe src={media.embed} title={title} loading="lazy" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen/>:media.type==='file'?<video controls playsinline preload="metadata" poster={poster}><source src={media.url}/><a href={media.url}>{title}</a></video>:<a href={media.url} target="_blank" rel="noopener noreferrer">{poster&&<img src={poster} alt="" loading="lazy"/>}<span aria-hidden="true">▶</span><strong>{title}</strong><small>{media.label} ↗</small></a>}
</div>}
<style>.published-video{aspect-ratio:16/9;position:relative;background:#161616;overflow:hidden;border-radius:12px}.published-video iframe,.published-video video{display:block;width:100%;height:100%;border:0}.published-video-link a{display:flex;position:relative;isolation:isolate;flex-direction:column;justify-content:center;align-items:center;gap:12px;height:100%;padding:24px;color:white;text-align:center}.published-video-link img{position:absolute;inset:0;height:100%;width:100%;object-fit:cover;z-index:-2;filter:brightness(.4)}.published-video-link span{font-size:30px}.published-video-link small{opacity:.7}</style>
